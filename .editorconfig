# EditorConfig is awesome: https://EditorConfig.org
# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python files
[*.py]
indent_style = space
indent_size = 4
max_line_length = 180

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# TOML files (pyproject.toml, etc.)
[*.toml]
indent_style = space
indent_size = 4

# Markdown files
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# Makefiles always use tabs
[Makefile]
indent_style = tab

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# Configuration files
[.flake8]
indent_style = space
indent_size = 4

[*.{cfg,ini}]
indent_style = space
indent_size = 4

# Ignore these file types
[*.{csv,svg,pdf,jpg,jpeg,png,gif,ico,mp4,mov}]
insert_final_newline = false
trim_trailing_whitespace = false
