# LLM API Configuration
# Choose ONE or more API keys from the providers below.
# The tool supports 100+ LLM providers via LiteLLM.

# === xAI (Grok) - Default ===
# Get your API key from https://x.ai/
GROK_API_KEY=your_api_key_here

# === Anthropic (Claude) ===
# Get your API key from https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_api_key_here

# === OpenAI (GPT) ===
# Get your API key from https://platform.openai.com/
# OPENAI_API_KEY=your_api_key_here

# === Google (Gemini) ===
# Get your API key from https://ai.google.dev/
# GOOGLE_API_KEY=your_api_key_here

# === Other Providers ===
# See https://docs.litellm.ai/docs/providers for 100+ supported providers

# === Optional: Model Selection ===
# Specify which model to use (if not set, defaults to grok-4-fast-reasoning if GROK_API_KEY is set)
# Examples:
#   LLM_MODEL=claude-3-5-sonnet-20241022
#   LLM_MODEL=gpt-4
#   LLM_MODEL=gemini-pro
#   LLM_MODEL=grok-beta
# LLM_MODEL=your_preferred_model

# Note: Copy this file to ~/.env and replace 'your_api_key_here' with your actual API key
# The tool will automatically load configuration from ~/.env
